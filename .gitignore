# ==============================================================================
# BlindCue — .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# PyInstaller / Nuitka
*.manifest
*.spec

# Installer logs & unit tests
pip-log.txt
pip-delete-this-directory.txt
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Local show project autosaves & crash recovery
autosave.json
*.tmp
*.bak
*.swp
*~

# Temporary testing media & capture screenshots
scratch/
test_*.mp4
test_*.wav
test_*.png
test_*.jpg
ui_preview_*.png

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE workspace files (keeps general .vscode/settings.json, ignores local user data)
.vscode/*
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace

